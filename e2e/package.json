{
  "name": "natodi-qa-test-task",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript test task for the Natodi booking flow",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test src/tests/booking",
    "test:api": "playwright test src/tests/api",
    "test:headed": "playwright test src/tests/booking --headed",
    "test:reliability": "playwright test --config=playwright.reliability.config.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.1.0",
    "typescript": "5.9.3"
  }
}
